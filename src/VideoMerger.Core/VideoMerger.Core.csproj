<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net48 dipilih supaya exe-nya tetap kecil dan pengguna tidak perlu
    mengunduh runtime apa pun: Windows 10 1903 ke atas sudah membawa
    .NET Framework 4.8, dan Windows 7 SP1 / 8.1 cukup memasangnya sekali.
    .NET 8 self-contained akan berukuran ~150 MB karena WPF tidak mendukung
    trimming maupun NativeAOT.

    Sengaja tanpa satu pun PackageReference. Keluaran ffprobe dibaca dengan
    "-of flat" (baris key=value) alih-alih JSON, dan pengaturan disimpan
    sebagai key=value biasa, sehingga tidak ada DLL yang harus ikut
    didistribusikan bersama exe-nya.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VideoMerger.Core</AssemblyName>
    <RootNamespace>VideoMerger.Core</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.1.0</Version>
    <NeutralLanguage>id-ID</NeutralLanguage>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!--
    Assembly BCL, bukan paket NuGet: keduanya sudah ada di setiap pemasangan
    .NET Framework, jadi tidak ada DLL yang ikut didistribusikan.
    System.IO.Compression.FileSystem yang menyediakan ExtractToFile.
  -->
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <!-- JavaScriptSerializer: pengurai JSON bawaan .NET Framework, dipakai
         untuk keluaran ffprobe supaya tidak perlu paket NuGet apa pun. -->
    <Reference Include="System.Web.Extensions" />
    <!-- WMI, hanya untuk membaca nama kartu grafis yang ditampilkan. -->
    <Reference Include="System.Management" />
  </ItemGroup>

</Project>
