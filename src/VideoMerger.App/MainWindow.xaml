<Window x:Class="VideoMerger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Merger" Height="780" Width="1180"
        MinHeight="640" MinWidth="960"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Body}"/>
        <Style TargetType="Button" BasedOn="{StaticResource Btn}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource Field}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource Picker}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource Tick}"/>
        <Style TargetType="DataGrid" BasedOn="{StaticResource Grid}">
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}"/>
            <Setter Property="RowStyle" Value="{StaticResource GridRow}"/>
            <Setter Property="CellStyle" Value="{StaticResource GridCell}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================== kepala -->
        <Grid Grid.Row="0" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Video Merger" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="1" x:Name="LblVersion" Text="  v1.1.0"
                       Style="{StaticResource Hint}" Margin="0,5,0,0"/>
            <TextBlock Grid.Column="2" x:Name="LblFFmpeg" Text="Mencari FFmpeg..."
                       Style="{StaticResource Hint}" Margin="0,5,0,0"/>
        </Grid>

        <!-- ==================================================== tab -->
        <TabControl Grid.Row="1" x:Name="Tabs" Style="{StaticResource Tabs}"
                    SelectionChanged="OnTabChanged">

            <!-- ==================================== 1. gabungkan video -->
            <TabItem Header="Gabungkan Video" Style="{StaticResource Tab}">
                <Grid Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Folder video" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtFolder"
                                 KeyDown="OnFolderKeyDown"/>
                        <Button Grid.Column="2" Content="Pilih Folder" Margin="8,0,0,0"
                                Click="OnChooseFolder"/>
                        <Button Grid.Column="3" Content="Muat Ulang" Margin="6,0,0,0"
                                Click="OnRescan"/>
                    </Grid>
                    <CheckBox Grid.Row="1" x:Name="ChkRecursive" Content="Termasuk subfolder"
                              Margin="0,9,0,0" Click="OnRescan"/>

                    <Separator Grid.Row="2" Margin="0,12,0,0"
                               Background="{StaticResource BorderBrushSoft}"/>

                    <DockPanel Grid.Row="2" Margin="0,20,0,8" VerticalAlignment="Bottom">
                        <TextBlock DockPanel.Dock="Left" Text="Urutkan" Margin="0,0,8,0"/>
                        <ComboBox DockPanel.Dock="Left" x:Name="CmbSort" Width="215"
                                  SelectionChanged="OnSortChanged"/>
                        <CheckBox DockPanel.Dock="Left" x:Name="ChkDesc" Content="Menurun"
                                  Margin="10,0,16,0" Click="OnSortChanged"/>
                        <Button DockPanel.Dock="Left" Content="Naik"
                                Style="{StaticResource BtnTool}" Click="OnMoveUp"/>
                        <Button DockPanel.Dock="Left" Content="Turun"
                                Style="{StaticResource BtnTool}" Click="OnMoveDown"/>
                        <Button DockPanel.Dock="Left" Content="Hapus"
                                Style="{StaticResource BtnTool}" Click="OnRemove"/>
                        <Button DockPanel.Dock="Left" Content="Centang Semua"
                                Style="{StaticResource BtnTool}" Click="OnCheckAll"/>
                        <Button DockPanel.Dock="Left" Content="Lepas Semua"
                                Style="{StaticResource BtnTool}" Click="OnUncheckAll"/>
                        <TextBlock x:Name="LblSummary" Style="{StaticResource Hint}"
                                   HorizontalAlignment="Right" TextAlignment="Right"/>
                    </DockPanel>

                    <DataGrid Grid.Row="3" x:Name="GridFiles" MinHeight="120"
                              MouseDoubleClick="OnFileDoubleClick"
                              PreviewKeyDown="OnGridKeyDown">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
                            <DataGridTextColumn Header="Nama File" Binding="{Binding Name}"
                                                Width="*" MinWidth="160"/>
                            <DataGridTextColumn Header="Durasi" Binding="{Binding Duration}"
                                                Width="78"/>
                            <DataGridTextColumn Header="Resolusi" Binding="{Binding Resolution}"
                                                Width="84"/>
                            <DataGridTextColumn Header="Video" Binding="{Binding Codec}"
                                                Width="60"/>
                            <DataGridTextColumn Header="Audio" Binding="{Binding Audio}"
                                                Width="86"/>
                            <DataGridTextColumn Header="Ukuran" Binding="{Binding Size}"
                                                Width="78"/>
                            <DataGridTextColumn Header="Tanggal" Binding="{Binding Date}"
                                                Width="116"/>
                            <DataGridTextColumn Header="Keterangan" Binding="{Binding Status}"
                                                Width="*" MinWidth="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Simpan sebagai" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="TxtOutput"/>
                            <Button Grid.Column="2" Content="Simpan Ke" Margin="8,0,0,0"
                                    Click="OnChooseOutput"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Metode" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbMode" Width="215"
                                      SelectionChanged="OnModeChanged"/>
                            <TextBlock Text="Kualitas (CRF)" Margin="18,0,8,0"/>
                            <TextBox x:Name="TxtCrf" Width="46" Text="23"/>
                            <TextBlock Text="Encoder" Margin="18,0,8,0"/>
                            <ComboBox x:Name="CmbEncoder" Width="205"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================================== 2. subtitle permanen -->
            <TabItem Header="Subtitle Permanen" Style="{StaticResource Tab}">
                <Grid Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Folder video" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtSubFolder"
                                 KeyDown="OnSubFolderKeyDown"/>
                        <Button Grid.Column="2" Content="Pilih Folder" Margin="8,0,0,0"
                                Click="OnSubChooseFolder"/>
                        <Button Grid.Column="3" Content="Pilih Berkas" Margin="6,0,0,0"
                                Click="OnSubChooseFiles"/>
                        <Button Grid.Column="4" Content="Muat Ulang" Margin="6,0,0,0"
                                Click="OnSubRescan"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,7,0,0"
                               Text="Subtitle diambil otomatis dari dalam video, atau dari berkas .srt/.ass yang senama di folder yang sama."/>

                    <Separator Grid.Row="2" Margin="0,12,0,0"
                               Background="{StaticResource BorderBrushSoft}"/>

                    <DockPanel Grid.Row="2" Margin="0,20,0,8" VerticalAlignment="Bottom">
                        <Button DockPanel.Dock="Left" Content="Centang Semua"
                                Style="{StaticResource BtnTool}" Click="OnSubCheckAll"/>
                        <Button DockPanel.Dock="Left" Content="Lepas Semua"
                                Style="{StaticResource BtnTool}" Click="OnSubUncheckAll"/>
                        <Button DockPanel.Dock="Left" Content="Hapus"
                                Style="{StaticResource BtnTool}" Click="OnSubRemove"/>
                        <TextBlock x:Name="LblSubSummary" Style="{StaticResource Hint}"
                                   HorizontalAlignment="Right" TextAlignment="Right"/>
                    </DockPanel>

                    <DataGrid Grid.Row="3" x:Name="GridSubs" MinHeight="100"
                              SelectionChanged="OnSubSelectionChanged"
                              MouseDoubleClick="OnSubDoubleClick"
                              PreviewKeyDown="OnSubGridKeyDown">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
                            <DataGridTextColumn Header="Nama File" Binding="{Binding Name}"
                                                Width="*" MinWidth="170"/>
                            <DataGridTextColumn Header="Durasi" Binding="{Binding Duration}"
                                                Width="78"/>
                            <DataGridTextColumn Header="Resolusi" Binding="{Binding Resolution}"
                                                Width="84"/>
                            <DataGridTextColumn Header="Subtitle yang dipakai"
                                                Binding="{Binding Source}" Width="*"
                                                MinWidth="150"/>
                            <DataGridTextColumn Header="Keterangan" Binding="{Binding Status}"
                                                Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Subtitle untuk baris terpilih"
                                   Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" x:Name="CmbSubSource"
                                  SelectionChanged="OnSubSourceChanged"/>
                        <Button Grid.Column="2" Content="Ambil dari Berkas" Margin="8,0,0,0"
                                Click="OnSubChooseFile"/>
                    </Grid>

                    <StackPanel Grid.Row="5" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkStyle" Content="Atur tampilan subtitle"
                                      Margin="0,0,16,0" Click="OnStyleToggled"/>
                            <TextBlock Text="Font" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbFont" Width="150"/>
                            <TextBlock Text="Ukuran" Margin="16,0,8,0"/>
                            <TextBox x:Name="TxtSubSize" Width="46" Text="24"/>
                            <TextBlock Text="Warna" Margin="16,0,8,0"/>
                            <Button x:Name="BtnColour" Width="34" Content=" "
                                    Click="OnPickPrimary"/>
                            <TextBlock Text="Garis tepi" Margin="16,0,8,0"/>
                            <Button x:Name="BtnOutline" Width="34" Content=" "
                                    Click="OnPickOutline"/>
                            <CheckBox x:Name="ChkBold" Content="Tebal" Margin="16,0,0,0"/>
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Simpan hasil ke"
                                       Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="TxtOutDir"/>
                            <Button Grid.Column="2" Content="Pilih" Margin="8,0,0,0"
                                    Click="OnChooseOutDir"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Akhiran nama" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtSuffix" Width="130"/>
                            <TextBlock Text="Format" Margin="18,0,8,0"/>
                            <ComboBox x:Name="CmbContainer" Width="80"/>
                            <TextBlock Text="Kualitas (CRF)" Margin="18,0,8,0"/>
                            <TextBox x:Name="TxtSubCrf" Width="46" Text="20"/>
                            <CheckBox x:Name="ChkCopyAudio" Margin="18,0,0,0"
                                      Content="Salin audio tanpa encode ulang"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============================================ panel bawah -->
        <Border Grid.Row="2" Background="{StaticResource Card}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                CornerRadius="8" Margin="0,10,0,0" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0" x:Name="Bar" Style="{StaticResource Bar}"
                             Minimum="0" Maximum="1000"/>

                <Grid Grid.Row="1" Margin="0,9,0,10">
                    <TextBlock x:Name="LblStatus" Text="Siap." HorizontalAlignment="Left"/>
                    <TextBlock x:Name="LblEta" Style="{StaticResource Hint}"
                               HorizontalAlignment="Right"/>
                </Grid>

                <DockPanel Grid.Row="2">
                    <Button DockPanel.Dock="Left" x:Name="BtnPrimary"
                            Content="GABUNGKAN VIDEO" Style="{StaticResource BtnAccent}"
                            Click="OnPrimary"/>
                    <Button DockPanel.Dock="Left" x:Name="BtnCancel" Content="Batalkan"
                            Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                            IsEnabled="False" Click="OnCancel"/>
                    <Button DockPanel.Dock="Left" x:Name="BtnOpen"
                            Content="Buka Folder Hasil" Margin="8,0,0,0"
                            IsEnabled="False" Click="OnOpenResult"/>
                    <CheckBox x:Name="ChkLog" Content="Log teknis" DockPanel.Dock="Right"
                              HorizontalAlignment="Right" Click="OnToggleLog"/>
                </DockPanel>

                <Border Grid.Row="3" x:Name="LogBox" Visibility="Collapsed"
                        Background="#F7F9FC" CornerRadius="5" Margin="0,10,0,0"
                        Height="150">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent"
                             FontFamily="{StaticResource MonoFont}" FontSize="11"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
